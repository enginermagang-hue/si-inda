# Port API backend
PORT=3001
# Secret untuk menandatangani JWT admin (WAJIB diganti di production)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Kosongkan = pakai SQLite file lokal (server/dev.db).
# Isi dengan URL Turso untuk production, contoh: libsql://siindah-xxx.turso.io
TURSO_URL=
# Token auth Turso (wajib jika TURSO_URL diisi)
TURSO_AUTH_TOKEN=
# Akun admin awal untuk seeding (npm run seed)
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
