{
  // Tsconfig untuk serverless function Vercel (api/[[...route]].ts + server/src).
  // Vercel me-type-check program function memakai TypeScript root; file ini
  // memastikan Node types selalu ikut walau checker memakai default minim.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["[[...route]].ts", "../server/src/**/*"]
}
