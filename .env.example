# Salin ke .env lalu isi. Di production (Vercel), isi via dashboard Environment Variables.
# Kosongkan NUXT_TURSO_URL = pakai SQLite lokal (dev.db).

# Secret JWT admin (WAJIB diganti, minimal 32 karakter)
NUXT_JWT_SECRET=dev-only-ganti-di-production-minimal-32-karakter-xyz

# Turso (contoh: libsql://siindah-xxx.turso.io)
NUXT_TURSO_URL=
NUXT_TURSO_AUTH_TOKEN=

# Storage PDF surat: local (dev, public/uploads) atau dropbox (production)
NUXT_STORAGE_DRIVER=local
NUXT_DROPBOX_APP_KEY=
NUXT_DROPBOX_APP_SECRET=
NUXT_DROPBOX_REFRESH_TOKEN=
NUXT_DROPBOX_FOLDER=/siindah/surat

# Akun admin awal untuk seeding (npm run db:seed)
NUXT_ADMIN_NAME=Administrator
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=admin123
